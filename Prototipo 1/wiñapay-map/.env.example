# Sin estas variables la app funciona en modo local: lee src/data/*.json y guarda
# testimonios e iniciativas (pendientes de moderación) en .data/*.json.
#
# Con ellas, las rutas /api/* usan Supabase. Solo se necesita la clave "anon":
# la seguridad la dan las políticas RLS de supabase/schema.sql.
# Nunca pongas aquí la clave de servicio ni la subas al repositorio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
